# SatQuery backend environment configuration.
# Copy to .env and adjust for your environment.

SATQUERY_ENVIRONMENT=development
SATQUERY_LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (frontend dev server).
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Geospatial grounding (OpenStreetMap Nominatim).
SATQUERY_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SATQUERY_NOMINATIM_USER_AGENT=SatQuery/0.1 (SIH 2026 PS 26167; +https://github.com/karthikbalaji1111-wq)
SATQUERY_HTTP_TIMEOUT_SECONDS=10

# Sentinel-2 scene discovery (Earth Search STAC API - no credentials required).
SATQUERY_STAC_BASE_URL=https://earth-search.aws.element84.com/v1
SATQUERY_STAC_COLLECTION=sentinel-2-l2a

# Bounded Sentinel-2 imagery retrieval (windowed COG reads).
SATQUERY_IMAGERY_MAX_DIMENSION=1024
SATQUERY_IMAGERY_HARD_MAX_DIMENSION=2048
SATQUERY_IMAGERY_MAX_WINDOW_PIXELS=50000000

# Natural-language intent extraction via the Google Gemini API (google-genai).
# Standard variable names, NOT prefixed with SATQUERY_. Leave GEMINI_API_KEY
# blank here; set a real key only in your local .env (git-ignored) and never
# commit it. Without GEMINI_API_KEY the /query/parse endpoint returns 502.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SATQUERY_GEMINI_TIMEOUT_SECONDS=30

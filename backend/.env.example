# SatQuery backend environment configuration.
# Copy to .env and adjust for your environment.

SATQUERY_ENVIRONMENT=development
SATQUERY_LOG_LEVEL=INFO

# Allowed CORS origins (frontend dev server), as a JSON list. The settings
# loader JSON-decodes list fields, so a comma-separated value fails at startup.
SATQUERY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Geospatial grounding (OpenStreetMap Nominatim).
SATQUERY_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SATQUERY_NOMINATIM_USER_AGENT=SatQuery/0.1 (SIH 2026 PS 26167; +https://github.com/karthikbalaji1111-wq)
SATQUERY_HTTP_TIMEOUT_SECONDS=10

# Satellite scene discovery - no credentials required.
# Sentinel-2 L2A comes from Earth Search.
SATQUERY_STAC_BASE_URL=https://earth-search.aws.element84.com/v1
SATQUERY_STAC_COLLECTION=sentinel-2-l2a
# Sentinel-1 comes from Microsoft Planetary Computer's RTC collection: provider
# terrain-corrected gamma naught, readable over HTTPS. Do NOT set sentinel-1-grd:
# Earth Search publishes GRD on a requester-pays s3:// bucket in radar geometry,
# so its imagery is refused and no backscatter can be computed.
SATQUERY_STAC_S1_COLLECTION=sentinel-1-rtc

# Bounded Sentinel-2 imagery retrieval (windowed COG reads).
SATQUERY_IMAGERY_MAX_DIMENSION=1024
SATQUERY_IMAGERY_HARD_MAX_DIMENSION=2048
SATQUERY_IMAGERY_MAX_WINDOW_PIXELS=50000000

# Natural-language intent extraction via the Google Gemini API (google-genai).
# Standard variable names, NOT prefixed with SATQUERY_. Leave GEMINI_API_KEY
# blank here; set a real key only in your local .env (git-ignored) and never
# commit it. Without GEMINI_API_KEY the /query/parse endpoint returns 502.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SATQUERY_GEMINI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Which vision-language backend answers the agent's visual-analysis step.
# Accepted values: gemini | nvidia | anthropic | local. All four run through the SAME
# agent orchestration, grounding and evidence path - only the inference backend
# differs. There is no fallback between them: if the selected provider has no
# key, the visual step fails rather than answering as another provider,
# because an unattributable observation is worse than a missing one.
AI_PROVIDER=gemini

# Anthropic's Claude models, via the official `anthropic` Python SDK.
# Standard unprefixed variable names, as the SDK itself documents. Leave
# ANTHROPIC_API_KEY blank here; set a real key only in your local .env
# (git-ignored) and never commit it.
# Every catalogued Claude model accepts image input, so all of them serve both
# the text roles (planning, synthesis, intent parsing) and the visual one:
#   claude-opus-5      (default - most capable)
#   claude-sonnet-5
#   claude-haiku-4-5
# ANTHROPIC_BASE_URL is for testing only and should stay unset in a real
# deployment. No sampling parameters are sent: temperature/top_p/top_k are
# rejected by the current Claude models.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SATQUERY_ANTHROPIC_TIMEOUT_SECONDS=120

# NVIDIA-hosted NIM endpoints, which speak the OpenAI chat-completions dialect.
# The model MUST accept image input - the visual path sends a satellite PNG, so
# a text-only model (including most Nemotron variants) cannot serve it.
# Leave NVIDIA_API_KEY blank here; set a real key only in your local .env
# (git-ignored) and never commit it.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA hosts many models; SatQuery exposes only those catalogued as able to
# fill one of its roles, and filters by capability per step. Image-capable
# models verified against NVIDIA's documentation at implementation time:
#   nvidia/nemotron-nano-12b-v2-vl                  (VLM) - RETIRED 2026-08-26
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning   (omni: text/image/video)
#   meta/llama-3.2-11b-vision-instruct              (VLM)
# Text-only - selectable for text roles, REFUSED for visual analysis:
#   nvidia/nemotron-3-super-120b-a12b
#   nvidia/nemotron-3.5-lightning-30b-a3b
# Free-endpoint availability, rate limits and the catalog itself change over
# time; verify against NVIDIA's current catalog rather than trusting this list
# to stay complete. GET /api/v1/ai/models reports what this deployment sees.
# nemotron-nano-12b-v2-vl was RETIRED by NVIDIA on 2026-08-26 (410 Gone).
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ---------------------------------------------------------------------------
# Local open-weight model via Ollama (AI_PROVIDER=local) - no key, no quota
# ---------------------------------------------------------------------------
# Requests go to LOCAL_AI_BASE_URL and nowhere else. There is no fallback: if
# Ollama is not running or the model is not installed, the run fails saying so.
#
# Install Ollama (https://ollama.com/download, or `brew install ollama`), then:
#   ollama pull qwen3-vl:4b-instruct
#
# Use an -instruct tag. Every plain qwen3-vl tag (qwen3-vl:4b, :8b, ...) is the
# THINKING variant, which reasons in hidden tokens whatever you ask and is far
# too slow for interactive use on a small machine.
#
#   qwen3-vl:2b-instruct        1.9 GB   lowest memory; failed most SatQuery tasks in testing
#   qwen3-vl:4b-instruct        3.3 GB   default; verified on an 8 GB Apple M2
#   qwen3-vl:8b-instruct        6.1 GB   16 GB or more
#   qwen3-vl:30b-a3b-instruct  19.6 GB   32 GB or more
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3-vl:4b-instruct
# The first request after a restart loads the model; allow for it.
SATQUERY_LOCAL_AI_TIMEOUT_SECONDS=300
# Every SatQuery prompt fits in 4096 tokens; a larger window costs memory.
SATQUERY_LOCAL_AI_NUM_CTX=4096

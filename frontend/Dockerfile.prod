# SatQuery frontend - production image.
#
# The development image runs `vite dev`, which is a compiler and a file watcher
# with a web server attached. It serves modules straight from node_modules,
# which is why the MapLibre worker resolved there and worked in development
# while being absent from a real build. Shipping a BUILT artefact and serving it
# statically is what makes the deployed thing the thing that was tested.

FROM node:22-alpine AS build

WORKDIR /app

# Dependencies from the lockfile: `npm ci` fails rather than resolving anew.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Where the browser should send API calls. Baked at BUILD time because Vite
# inlines it - so an image is built for a deployment, and the value is a URL,
# never a credential. No secret is ever passed here.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# `npm run build` runs `tsc -b` first, so a type error fails the image build
# rather than shipping.
RUN npm run build

# ---------------------------------------------------------------------------
# The runtime holds no toolchain, no node_modules and no source - only the
# built files and a static server. Unprivileged nginx listens on 8080 as a
# non-root user.
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/index.html || exit 1
